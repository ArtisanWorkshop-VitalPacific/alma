{
  "$description": "Alma design tokens. The live values are in src/app/globals.css. Keep the two in step.",
  "color": {
    "surface": {
      "paper": {
        "value": "#ffffff",
        "use": "Primary light section"
      },
      "mist": {
        "value": "#f5f5f7",
        "use": "Alternating light section"
      },
      "night": {
        "value": "#000000",
        "use": "Dark section"
      },
      "coal": {
        "value": "#1d1d1f",
        "use": "Panel on a dark section"
      },
      "stock": {
        "value": "#fbfaf7",
        "use": "Printed objects: magazine pages and documents in mock-ups"
      },
      "tile": {
        "value": "#161617",
        "use": "Tiles of the story library grid, on a dark section"
      }
    },
    "text": {
      "ink": {
        "value": "#1d1d1f",
        "use": "Primary text on light"
      },
      "ink-2": {
        "value": "#6e6e73",
        "use": "Secondary text on light"
      },
      "ink-3": {
        "value": "#86868b",
        "use": "Captions and fine print"
      },
      "snow": {
        "value": "#f5f5f7",
        "use": "Primary text on dark"
      },
      "snow-2": {
        "value": "#a1a1a6",
        "use": "Secondary text on dark"
      }
    },
    "accent": {
      "alma": {
        "value": "#1b3fa0",
        "use": "Buttons, links, eyebrows on light"
      },
      "alma-hover": {
        "value": "#2550c4",
        "use": "Hover on light"
      },
      "alma-sky": {
        "value": "#8fb0ff",
        "use": "Links and eyebrows on dark"
      }
    },
    "rule": {
      "hair": {
        "value": "rgb(0 0 0 / 0.08)"
      },
      "hair-strong": {
        "value": "rgb(0 0 0 / 0.14)"
      },
      "hair-on-dark": {
        "value": "rgb(255 255 255 / 0.1)"
      }
    }
  },
  "font": {
    "display": {
      "family": "Newsreader",
      "use": "Headings, lead paragraphs, item headings, numerals, the wordmark",
      "file": "src/fonts/Newsreader-opsz.woff2",
      "weights": [
        400,
        500
      ]
    },
    "text": {
      "family": "Geist",
      "weights": [
        400,
        500,
        600
      ],
      "use": "Body copy, labels, buttons, navigation",
      "file": "src/fonts/Geist-Variable.woff2"
    }
  },
  "type": {
    "hero": {
      "size": "clamp(2.5rem, 3.3vw + 1.05rem, 4.25rem)",
      "lineHeight": 1.05,
      "tracking": "-0.026em",
      "font": "display",
      "use": "The page title. A full sentence."
    },
    "heading": {
      "size": "clamp(1.875rem, 1.9vw + 1.2rem, 3rem)",
      "lineHeight": 1.1,
      "tracking": "-0.021em",
      "font": "display",
      "use": "Section headings"
    },
    "display-2": {
      "size": "clamp(1.625rem, 1.4vw + 1rem, 2.25rem)",
      "lineHeight": 1.12,
      "tracking": "-0.018em",
      "font": "display"
    },
    "subhead": {
      "size": "clamp(1.25rem, 0.4vw + 1.15rem, 1.4375rem)",
      "lineHeight": 1.22,
      "tracking": "-0.012em",
      "font": "display",
      "use": "Headings of items inside a section"
    },
    "lead": {
      "size": "clamp(1.1875rem, 0.6vw + 1.05rem, 1.4375rem)",
      "lineHeight": 1.46,
      "tracking": "-0.006em",
      "font": "display",
      "weight": 400,
      "use": "Lead paragraphs"
    },
    "title": {
      "size": "1.0625rem",
      "lineHeight": 1.3,
      "tracking": "-0.012em",
      "weight": 600
    },
    "body-lg": {
      "size": "clamp(1.0625rem, 0.4vw + 0.975rem, 1.25rem)",
      "lineHeight": 1.47,
      "tracking": "-0.008em"
    },
    "body": {
      "size": "1.0625rem",
      "lineHeight": 1.5
    },
    "body-sm": {
      "size": "0.875rem",
      "lineHeight": 1.43
    },
    "caption": {
      "size": "0.75rem",
      "lineHeight": 1.4
    },
    "label": {
      "size": "0.9375rem",
      "lineHeight": 1.4,
      "weight": 500,
      "case": "sentence",
      "use": "Section labels in the left column"
    }
  },
  "space": {
    "gutter": "clamp(1.375rem, 4vw, 3rem)",
    "section": "clamp(4.5rem, 8.5vw, 8.5rem)",
    "width-wide": "75rem",
    "width-text": "41rem",
    "label-column": "12.5rem"
  },
  "radius": {
    "input": "12px",
    "photo": "14px",
    "card": "18px",
    "tile": "22px",
    "pill": "980px"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "734px",
    "lg": "1068px",
    "xl": "1440px"
  },
  "motion": {
    "ease": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "reveal": "0.9s, 28px rise, once per block",
    "interaction": "0.2s to 0.3s",
    "hero": "The cover settles over 1.3s, then the library search panel and its three results arrive",
    "library": "When the grid scrolls into view: the question is typed, the answer and sources arrive, records and bars fill in once. Two slow loops follow: a filter selection (9s) and a calendar row in focus (12s). All of it is skipped with reduced motion."
  },
  "layout": {
    "section": "A label in a left column (sticky on desktop) with the heading and prose beside it. Stacked below 1068px.",
    "library": "A grid of tiles: 12 columns on desktop, 2 on tablet, 1 on a phone."
  }
}
