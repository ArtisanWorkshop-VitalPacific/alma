{
  "$description": "Alma design tokens. The live values are in src/app/globals.css. Keep the two in step.",
  "source": {
    "reference": "https://www.sectionai.com/",
    "recorded": "2026-11-26",
    "method": "Computed styles and CSS variables read from the home page at 1440px and 375px.",
    "matched": [
      "Colour values",
      "Type sizes, line heights and weights",
      "Spacing, page margins and section padding",
      "Radii and the card shadow",
      "Button, card, navigation and footer treatments",
      "The page rhythm: illustrated hero card, logo strip, white and warm bands, torn-paper edge into a dark closing band, black footer"
    ],
    "substituted": [
      {
        "item": "Goga (sans)",
        "with": "DM Sans",
        "why": "Goga is a commercial typeface. DM Sans is the closest open-licensed face of those compared, and is licensed under the SIL Open Font License."
      },
      {
        "item": "Azurio (serif labels)",
        "with": "Newsreader",
        "why": "Azurio is a commercial typeface. Newsreader was already in the site and is the closest open-licensed match of those compared."
      },
      {
        "item": "Secondary text #7a7770",
        "with": "#6b6862",
        "why": "Darkened so that small text passes WCAG AA on the warm bands."
      }
    ],
    "notCopied": [
      "Section's logo and wordmark",
      "Its illustrations, photographs, icons and paper textures",
      "Its copy",
      "Its font files",
      "The pixel and crayon display faces it uses for single words"
    ]
  },
