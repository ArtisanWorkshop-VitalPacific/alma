{
  "$description": "Alma design tokens. The live values are in src/app/globals.css. Keep the two in step.",
  "color": {
    "surface": {
      "paper": { "value": "#ffffff", "use": "Primary light section" },
      "mist": { "value": "#f5f5f7", "use": "Alternating light section" },
      "night": { "value": "#000000", "use": "Dark section" },
      "coal": { "value": "#1d1d1f", "use": "Panel on a dark section" },
      "stock": { "value": "#fbfaf7", "use": "Printed objects: magazine pages and documents in mock-ups" }
    },
    "text": {
      "ink": { "value": "#1d1d1f", "use": "Primary text on light" },
      "ink-2": { "value": "#6e6e73", "use": "Secondary text on light" },
      "ink-3": { "value": "#86868b", "use": "Captions and fine print" },
      "snow": { "value": "#f5f5f7", "use": "Primary text on dark" },
      "snow-2": { "value": "#a1a1a6", "use": "Secondary text on dark" }
    },
    "accent": {
      "alma": { "value": "#1b3fa0", "use": "Buttons, links, eyebrows on light" },
      "alma-hover": { "value": "#2550c4", "use": "Hover on light" },
      "alma-sky": { "value": "#8fb0ff", "use": "Links and eyebrows on dark" }
    },
    "rule": {
      "hair": { "value": "rgb(0 0 0 / 0.08)" },
      "hair-strong": { "value": "rgb(0 0 0 / 0.14)" },
      "hair-on-dark": { "value": "rgb(255 255 255 / 0.1)" }
    }
  },
  "font": {
    "display": {
      "family": "Newsreader",
      "weight": 500,
      "use": "Headlines, numbers, the quote, the wordmark",
      "file": "src/fonts/Newsreader-opsz.woff2"
    },
    "text": {
      "family": "Geist",
      "weights": [400, 500, 600],
      "use": "Body copy, labels, buttons, navigation",
      "file": "src/fonts/Geist-Variable.woff2"
    }
  },
  "type": {
    "hero": { "size": "clamp(2.75rem, 4.4vw + 1.2rem, 5.5rem)", "lineHeight": 1.02, "tracking": "-0.028em" },
    "display-1": { "size": "clamp(2.25rem, 3.4vw + 0.8rem, 4rem)", "lineHeight": 1.06, "tracking": "-0.024em" },
    "display-2": { "size": "clamp(1.75rem, 2vw + 0.9rem, 2.75rem)", "lineHeight": 1.1, "tracking": "-0.02em" },
    "number": { "size": "clamp(3rem, 4.2vw + 1.2rem, 5.25rem)", "lineHeight": 0.95, "tracking": "-0.035em" },
    "title": { "size": "clamp(1.1875rem, 0.5vw + 1.05rem, 1.375rem)", "lineHeight": 1.22, "tracking": "-0.014em", "weight": 600 },
    "body-lg": { "size": "clamp(1.0625rem, 0.5vw + 0.95rem, 1.3125rem)", "lineHeight": 1.45, "tracking": "-0.008em" },
    "body": { "size": "1.0625rem", "lineHeight": 1.47 },
    "body-sm": { "size": "0.875rem", "lineHeight": 1.43 },
    "caption": { "size": "0.75rem", "lineHeight": 1.33 },
    "eyebrow": { "size": "1.0625rem", "lineHeight": 1.33, "weight": 500, "case": "sentence" }
  },
  "space": {
    "gutter": "clamp(1.375rem, 4vw, 3rem)",
    "section": "clamp(5rem, 10vw, 10rem)",
    "width-wide": "75rem",
    "width-content": "61.25rem",
    "width-text": "37.5rem"
  },
  "radius": {
    "input": "12px",
    "card": "18px",
    "panel": "28px",
    "pill": "980px"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "734px",
    "lg": "1068px",
    "xl": "1440px"
  },
  "motion": {
    "ease": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "reveal": "0.9s, 28px rise, once per block",
    "interaction": "0.2s to 0.3s",
    "hero": "Cover settles over 1.3s, then the status card fills in step by step"
  }
}
